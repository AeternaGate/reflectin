# Supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Telegram
BOT_TOKEN=<bot token from @BotFather>
BOT_SECRET=<secret_token задаётся при setWebhook>

# OpenRouter
OPENROUTER_API_KEY=<api key>
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.0-flash:free,openai/gpt-oss-20b:free

# Mini App
WEBAPP_URL=https://<vercel-app>.vercel.app

# Лимит бесплатного тарифа (генераций в день на пользователя)
FREE_DAILY_QUOTA=5